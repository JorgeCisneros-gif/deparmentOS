# ============================
# EDIFY BACKEND - Variables de entorno
# Copia este archivo a .env y completa los valores
# ============================

# App
PORT=3000
NODE_ENV=development

# Database (edify_core en Docker)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=

# JWT
JWT_SECRET=edify_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=edify_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# OCR - Anthropic API (para lectura de medidores)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OCR_SERVICE_URL=http://localhost:8000
OCR_ENDPOINT=http://localhost:8000/ocr

# Upload (imágenes de medidores)
UPLOAD_DIR=./uploads/meters
MAX_FILE_SIZE_MB=10
# Housekeeping: eliminar imágenes más antiguas de N días (365 = 1 año)
UPLOAD_RETENTION_DAYS=365
# ============================================================
# Agregar estas variables al archivo .env del backend
# ============================================================
 
# ── Notificación de reset de contraseña ──────────────────────
# Opciones: email | whatsapp | both
RESET_NOTIFICATION=email
 
# URL del frontend (para construir el link de reset)
FRONTEND_URL=http://localhost:5173
 
# ── Configuración SMTP ────────────────────────────────────────
# Gmail con contraseña de aplicación:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Edify Sistema
SMTP_FROM_EMAIL=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d 
# Office 365 / Outlook:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
 
# Zoho Mail:
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_SECURE=false
 
# Brevo (ex Sendinblue) — recomendado para producción:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_api_key
# SMTP_PASS=tu_smtp_key
 
# ── Entorno ───────────────────────────────────────────────────
NODE_ENV=development   # En producción cambiar a: production

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=