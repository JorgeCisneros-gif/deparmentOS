# ============================================================
#  EDIFY — Variables de entorno unificadas
#  Copia este archivo a .env y completa los valores reales
#  NUNCA subas .env a GitHub
# ============================================================

# ── General ─────────────────────────────────────────────────
APP_NAME=Edify
NODE_ENV=production

# ── Base de datos ────────────────────────────────────────────
# DB_HOST siempre es "edify_db" en Docker (nombre del servicio)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edify_core
DB_USER=edify_user
DB_PASS=edify_pass_2024

# pgAdmin (interfaz web de la DB — opcional en producción)
PGADMIN_EMAIL=admin@edify.com
PGADMIN_PASSWORD=edify_pass_2024

# ── Backend (NestJS) ─────────────────────────────────────────
PORT=3000
UPLOAD_DIR=./uploads/meters
MAX_FILE_SIZE_MB=10
UPLOAD_RETENTION_DAYS=365

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=Q41II0gjhLF8HqnPJuqMTCH9K1nK3eKZWDUmXmPwiFk
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=fBd4qE686F4n1rQOE2ugKZZvCkELZRwzuvs1yzrljOA6C9ljKODN3xwPrkd
JWT_REFRESH_EXPIRES_IN=7d

# ── OCR / IA ─────────────────────────────────────────────────
