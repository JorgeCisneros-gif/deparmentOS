# ============================================================
# DepartmOS Scheduler — Variables de entorno
# Copia a .env y completa con tus valores
# ============================================================

# App
APP_NAME=DepartmOS
NODE_ENV=development

# ── Base de datos (mismos valores que el backend) ───────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edify_core
DB_USER=edify_user
DB_PASS=edify_pass_2024

# ── Cron ────────────────────────────────────────────────────
# Formato: segundo minuto hora día mes díaSemana
# "0 9 * * *"  = todos los días a las 9:00 AM
# "0 8 * * 1-5"= lunes a viernes a las 8:00 AM
# "*/5 * * * *" = cada 5 minutos (para pruebas)
SCHEDULER_CRON=0 9 * * *

# ── Email (SMTP) ─────────────────────────────────────────────
# Opción 1: Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu.correo@gmail.com
SMTP_PASS=tu_app_password_de_gmail

# Opción 2: Resend (recomendado — gratis 3000/mes)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxx

# Remitente que ve el destinatario
EMAIL_FROM=DepartmOS <notificaciones@tudominio.com>

# ── Canal activo ─────────────────────────────────────────────
# 'email' | 'push' (push requiere PWA implementada)
NOTIFICATION_CHANNEL=email

# ── Web Push (VAPID) ─────────────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
# IMPORTANTE: deben ser las MISMAS claves que en el backend
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@departmos.com
