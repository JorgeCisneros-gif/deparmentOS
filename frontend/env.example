# ============================
# EDIFY BACKEND - Variables de entorno
# Copia este archivo a .env y completa los valores
# ============================

# App
PORT=3000
NODE_ENV=development

# Database (edify_core en Docker)
DB_HOST=
DB_PORT=
DB_NAME=edify_core
DB_USER=edify_user
DB_PASS=edify_pass_2024

# ── JWT ──────────────────────────────────────────────────────────
# JWT_EXPIRES_IN: duración del access token (sesión activa)
#   Ejemplos: 1h, 2h, 8h, 1d
#   Recomendado producción: 1h  (el refresh token renueva automáticamente)
JWT_SECRET=edify_super_secret_key_change_in_production 
JWT_EXPIRES_IN=1h

# JWT_REFRESH_EXPIRES_IN: duración del refresh token (sesión total sin re-login)
#   Ejemplos: 7d, 14d, 30d
#   Cuando expira, el usuario debe volver a iniciar sesión.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# OCR - Anthropic API (para lectura de medidores)
ANTHROPIC_API_KEY=
VITE_API_URL=/api/v1
# Upload (imágenes de medidores)
UPLOAD_DIR=./uploads/meters
MAX_FILE_SIZE_MB=10
# Housekeeping: eliminar imágenes más antiguas de N días (365 = 1 año)
UPLOAD_RETENTION_DAYS=365
VITE_APP_NAME=DepartmOS